# MongoDB (required)
MONGODB_URI="mongodb://localhost:27017/dynamic-webhook-app"

# Clerk (required for auth + billing)
# Use pk_live_ / sk_live_ in production — never commit real keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"
# From Clerk Dashboard → Webhooks → Signing Secret (for /api/clerk/webhooks)
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Resend (required in production for email alerts)
RESEND_API_KEY=""
# Verified sender, e.g. "Endpoint Builders <alerts@endpoint.builders>"
RESEND_FROM="Endpoint Builders <webhooks@resend.dev>"

# Ingest hardening (optional)
# Max webhook requests per slug per minute
WEBHOOK_RATE_LIMIT_PER_MINUTE="120"
# Max request body size in bytes (default 1 MiB)
WEBHOOK_MAX_BODY_BYTES="1048576"
# Days to retain request logs (MongoDB TTL; default 30)
LOG_RETENTION_DAYS="30"
